{
  "name": "novel-agent",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "electron:dev": "wait-on http://localhost:5173 && set NODE_ENV=development&& electron electron/main.cjs",
    "electron:build": "npm run build && electron-builder"
  },
  "build": {
    "appId": "com.novelagent.app",
    "productName": "NovelAgent",
    "directories": {
      "output": "../release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../dist/novel-agent-server",
        "to": "novel-agent-server",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../config.yaml.example",
        "to": "config.yaml.example"
      },
      {
        "from": "dist",
        "to": "novel-agent-server/frontend/dist",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "NovelAgent"
    }
  },
  "devDependencies": {
    "@playwright/test": "1.45.0",
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.5.0",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "electron": "^42.4.1",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.1",
    "typescript": "~6.0.2",
    "vite": "^8.0.12",
    "wait-on": "^9.0.10"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.17",
    "@radix-ui/react-slot": "^1.3.0",
    "@tanstack/react-virtual": "^3.14.3",
    "clsx": "^2.1.1",
    "lucide-react": "^1.21.0",
    "react-router-dom": "^6.30.4",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.14"
  }
}
