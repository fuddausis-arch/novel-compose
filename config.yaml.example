# NovelCompose 配置文件模板
#
# 使用步骤：
# 1. 复制本文件为 config.yaml：cp config.yaml.example config.yaml
# 2. 在项目根目录创建 .env 文件，填入真实 API Key（.env 被 .gitignore 忽略，永不进 git）：
#      DEEPSEEK_API_KEY=sk-你的DeepSeek密钥
#      ARK_API_KEY=ark-你的火山方舟密钥
#      ARK_EMBEDDING_API_KEY=ark-你的方舟Embedding密钥
# 3. config.yaml 中用 ${VAR} 占位符引用 .env 里的 Key（config.py 自动展开）
#
# API Key 管理：
# - 真实 Key 只存在 .env（永不进 git），config.yaml 用 ${VAR} 占位符引用
# - 主 llm 的 api_key 必须填占位符；其他 agent 的 api_key 留空则自动回退主 llm
# - 去对应控制台申请 Key：
#     DeepSeek: https://platform.deepseek.com/api_keys
#     火山方舟: https://console.volcengine.com/ark/region:ark+cn-beijing/apiKey
#
# ============================================================
# 其他说明
# ============================================================
# 1. 思考模式由代码层强制开启（thinking + reasoning_effort=max），
#    temperature/top_p/frequency_penalty/presence_penalty 一律不发送，
#    因此配置中不再保留这些采样参数。
# 2. max_tokens：DeepSeek 官方接口可填 384000；火山方舟 glm-5.2 输出上限 128000，
#    使用 glm 的角色（writer/polisher）请填 128000。

# ===== LLM 主配置（必填 api_key 占位符）=====
llm:
  base_url: "https://api.deepseek.com"
  api_key: "${DEEPSEEK_API_KEY}"
  model: "deepseek-v4-flash"
  max_tokens: 384000
  timeout: 600.0
  vision_enabled: false
  context_length: 1000000

# ===== 审校独立 LLM（写审分离，api_key 留空自动回退主 llm）=====
auditor_llm:
  base_url: "https://api.deepseek.com"
  api_key: ""
  model: "deepseek-v4-flash"
  max_tokens: 384000
  timeout: 600.0
  vision_enabled: false
  context_length: 1000000

# ===== 多 Agent 模型分配（各司其职，api_key 留空自动回退主 llm）=====
agent_llm:
  planner:
    base_url: "https://api.deepseek.com"
    api_key: ""
    model: "deepseek-v4-flash"
    max_tokens: 384000
    timeout: 600.0
    vision_enabled: false
    context_length: 1000000
  architect:
    base_url: "https://api.deepseek.com"
    api_key: ""
    model: "deepseek-v4-flash"
    max_tokens: 384000
    timeout: 600.0
    vision_enabled: false
    context_length: 1000000
  outliner:
    base_url: "https://api.deepseek.com"
    api_key: ""
    model: "deepseek-v4-flash"
    max_tokens: 384000
    timeout: 600.0
    vision_enabled: false
    context_length: 1000000
  writer:
    base_url: "https://ark.cn-beijing.volces.com/api/coding/v3"
    api_key: "${ARK_API_KEY}"
    model: "glm-5.2"
    max_tokens: 128000
    timeout: 600.0
    vision_enabled: false
    context_length: 1000000
  auditor:
    base_url: "https://api.deepseek.com"
    api_key: ""
    model: "deepseek-v4-flash"
    max_tokens: 384000
    timeout: 600.0
    vision_enabled: false
    context_length: 1000000
  debater:
    base_url: "https://api.deepseek.com"
    api_key: ""
    model: "deepseek-v4-flash"
    max_tokens: 384000
    timeout: 600.0
    vision_enabled: false
    context_length: 1000000
  polisher:
    base_url: "https://ark.cn-beijing.volces.com/api/coding/v3"
    api_key: "${ARK_API_KEY}"
    model: "glm-5.2"
    max_tokens: 128000
    timeout: 600.0
    vision_enabled: false
    context_length: 1000000
  summarizer:
    base_url: "https://api.deepseek.com"
    api_key: ""
    model: "deepseek-v4-flash"
    max_tokens: 384000
    timeout: 600.0
    vision_enabled: false
    context_length: 1000000

# ===== Embedding 配置（方舟 doubao-embedding-vision，OpenAI 兼容协议）=====
embedding:
  api_key: "${ARK_EMBEDDING_API_KEY}"
  base_url: "https://ark.cn-beijing.volces.com/api/coding/v3"
  model: "doubao-embedding-vision-251215"

# ===== 项目数据目录（留空则使用默认路径）=====
# 打包模式下自动使用 %APPDATA%\NovelCompose\project_data
# 开发模式下使用项目根目录的 project_data/
# project_data_dir: "C:/Users/你的用户名/Documents/NovelComposeData"

# ===== 末日文向量语料库 RAG 开关 =====
enable_genre_rag: true

# ===== 章纲/细纲内容不足时，允许 AI 自行扩充剧情 =====
allow_auto_expand_chapter: true
